{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team mode plan and acceptance checklist, contract v1 (written by the PM, approved by the user)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "title_vi", "goal_vi", "plan", "checklist", "out_of_scope_vi"],
  "properties": {
    "contract_version": {"const": 1},
    "title_vi": {"type": "string", "minLength": 1, "maxLength": 120},
    "goal_vi": {"type": "string", "minLength": 1, "maxLength": 600},
    "plan": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "what_vi", "files"],
        "properties": {
          "step": {"type": "integer", "minimum": 1, "maximum": 12},
          "what_vi": {"type": "string", "minLength": 1, "maxLength": 300},
          "files": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
        }
      }
    },
    "checklist": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text_vi", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^C([1-9]|1[0-2])$"},
          "text_vi": {"type": "string", "minLength": 1, "maxLength": 200},
          "check": {
            "description": "kind command needs argv; file_contains needs path and text; http_ok needs url (localhost only); review needs look_for_vi.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"type": "string", "enum": ["command", "file_contains", "http_ok", "review"]},
              "argv": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
              "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255},
              "timeout_s": {"type": "integer", "minimum": 1, "maximum": 900},
              "path": {"type": "string", "minLength": 1, "maxLength": 200},
              "text": {"type": "string", "minLength": 1, "maxLength": 200},
              "url": {"type": "string", "pattern": "^http://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?(/.*)?$"},
              "look_for_vi": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        }
      }
    },
    "out_of_scope_vi": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  }
}
